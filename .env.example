# ============================================================
# Milford Haven Bass Chart
# Environment configuration template
# ============================================================
#
# Copy to .env.local for local development if configuration
# changes are required.
#
# NEVER store private catch data, passwords or secret API keys
# in this file.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NEXT_PUBLIC_APP_NAME="Milford Haven Bass Chart"

# Initial chart centre — Milford Haven / Pembrokeshire region
NEXT_PUBLIC_MAP_CENTER_LAT=51.7000
NEXT_PUBLIC_MAP_CENTER_LON=-5.1000

# Initial map zoom.
# Users will be able to zoom considerably further for precise
# catch placement and detailed structure inspection.
NEXT_PUBLIC_MAP_INITIAL_ZOOM=10


# ------------------------------------------------------------
# Open geographic / bathymetric data
# ------------------------------------------------------------
#
# Provider endpoints will be implemented through adapters.
# URLs are intentionally not hard-coded here until each source
# and its usage/licensing requirements have been verified.
#
# The application must remain capable of replacing a provider
# without changing the catch or prediction data models.
# ------------------------------------------------------------

NEXT_PUBLIC_BATHYMETRY_PROVIDER="emodnet"
NEXT_PUBLIC_BASEMAP_PROVIDER="open"


# ------------------------------------------------------------
# Weather / marine environment
# ------------------------------------------------------------
#
# Core providers must not require paid subscriptions or user
# login credentials.
# ------------------------------------------------------------

NEXT_PUBLIC_WEATHER_PROVIDER="open-meteo"
NEXT_PUBLIC_MARINE_PROVIDER="open-meteo"


# ------------------------------------------------------------
# Tide
# ------------------------------------------------------------
#
# Tide enrichment is automatic.
#
# A catch timestamp + position will be used to derive:
#
# - surrounding HW / LW
# - tidal height
# - tidal phase
# - flood / ebb
# - minutes relative to HW / LW
# - tidal range
# - normalized tidal-cycle position
#
# Tidal-stream behaviour is stored separately from water-level
# phase because local current reversals do not necessarily
# occur at HW or LW.
# ------------------------------------------------------------

NEXT_PUBLIC_TIDE_MODE="automatic"


# ------------------------------------------------------------
# Privacy
# ------------------------------------------------------------
#
# Exact catches, marks, tracks and fishing effort remain local
# unless the user deliberately exports them.
# ------------------------------------------------------------

NEXT_PUBLIC_PRIVATE_DATA_MODE="local"
